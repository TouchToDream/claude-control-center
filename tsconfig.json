{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "web/src/drafts.ts",
    "web/src/selection.ts",
    "web/src/**/*.test.ts",
    "web/src/unread.ts",
    "web/src/attachments.ts",
    "web/src/shell.ts"
  ]
}
